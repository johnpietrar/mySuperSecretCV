    <div class="gamepad-container">
        <svg id="gamepad" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128px" height="128px">
            <!-- Gamepad body -->
            <rect x="8" y="28" width="112" height="60" fill="#333" stroke="#FFF" stroke-width="4"></rect>
            <!-- D-pad -->
            <rect x="20" y="55" width="8" height="8" fill="#FFF"></rect>
            <rect x="28" y="55" width="8" height="8" fill="#FFF"></rect>
            <rect x="36" y="55" width="8" height="8" fill="#FFF"></rect>
            <rect x="28" y="47" width="8" height="8" fill="#FFF"></rect>
            <rect x="28" y="63" width="8" height="8" fill="#FFF"></rect>
            <!-- Four colored buttons -->
            <circle cx="91" cy="50" r="6" fill="#FF0000"></circle> <!-- Red -->
            <circle cx="106" cy="50" r="6" fill="#00FF00"></circle> <!-- Green -->
            <circle cx="90" cy="66" r="6" fill="#0000FF"></circle> <!-- Blue -->
            <circle id="lego-button" cx="106" cy="66" r="6" fill="#FFFF00" style="cursor: pointer;"></circle> <!-- Yellow - LEGO Easter Egg -->
            <!-- Start and Select buttons -->
            <rect id="start-button" x="52" y="58" width="10" height="4" fill="#FFF" style="cursor: pointer;"></rect>
            <rect x="66" y="58" width="10" height="4" fill="#FFF"></rect>
            <!-- Cable -->
            <path d="M64,28 Q64,18 54,18 T44,8" stroke="#FFF" stroke-width="2" fill="none"></path>
        </svg>
    </div>

    <!-- Hidden LEGO Easter Egg Modal -->
    <div id="lego-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2>🧱 LEGO MASTER BUILDER UNLOCKED! 🧱</h2>
            <p>You've discovered the secret LEGO Easter Egg!</p>
            <div class="lego-bricks">
                <div class="brick brick-red"></div>
                <div class="brick brick-blue"></div>
                <div class="brick brick-yellow"></div>
                <div class="brick brick-green"></div>
            </div>
            <p style="margin-top: 20px; font-size: 0.8em;">Fun Fact: The LEGO Magazine infrastructure processes millions of requests monthly!</p>
        </div>
    </div>
    
    <script>
        document.getElementById('start-button').addEventListener('click', function() {
            window.open('https://www.google.com/logos/2010/pacman10-i.html', '_blank');
        });

        document.getElementById('start-button').addEventListener('mouseover', function() {
            this.setAttribute('fill', '#FFD700');
        });

        document.getElementById('start-button').addEventListener('mouseout', function() {
            this.setAttribute('fill', '#FFF');
        });

        // LEGO Button Easter Egg
        document.getElementById('lego-button').addEventListener('click', function() {
            document.getElementById('lego-modal').style.display = 'block';
        });

        document.querySelector('.close-modal').addEventListener('click', function() {
            document.getElementById('lego-modal').style.display = 'none';
        });

        window.addEventListener('click', function(event) {
            const modal = document.getElementById('lego-modal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.7.1/gsap.min.js"></script>
